diff --git a/tools/mcp_tasks_extension.py b/tools/mcp_tasks_extension.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd9fc64b595469e21d0f9d5697e47e9a860a4997
--- /dev/null
+++ b/tools/mcp_tasks_extension.py
@@ -0,0 +1,211 @@
+"""Wire helpers for the ``io.modelcontextprotocol/tasks`` MCP extension.
+
+The installed MCP SDK exposes the standard ``tools/call`` request model but not
+the 2026 Tasks extension methods.  Use the SDK model for tool calls and a small
+raw request shim only for custom task methods so ``tools/mcp_tool.py`` remains
+focused on transport lifecycle and registry wiring.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, ClassVar
+
+from pydantic import RootModel
+
+
+TASKS_EXTENSION_ID = "io.modelcontextprotocol/tasks"
+TASK_ROUTING_METHODS = frozenset({"tasks/get", "tasks/update", "tasks/cancel"})
+_MISSING = object()
+logger = logging.getLogger(__name__)
+
+
+class _RawRequest(RootModel[dict[str, Any]]):
+    # MCP SDK 2.x inspects this class attribute before dispatch. Custom task
+    # methods carry their routing identity in taskId/Mcp-Name, not a generic
+    # params.name field, so they deliberately opt out of SDK name extraction.
+    name_param: ClassVar[str | None] = None
+
+
+class _RawResult(RootModel[dict[str, Any]]):
+    pass
+
+
+def _mcp_field(value: Any, snake: str, camel: str, default: Any = None) -> Any:
+    """Read a model field across the MCP SDK 1.x to 2.x rename."""
+    resolved = getattr(value, snake, _MISSING)
+    if resolved is not _MISSING:
+        return resolved
+    resolved = getattr(value, camel, _MISSING)
+    return default if resolved is _MISSING else resolved
+
+
+def client_capability_meta() -> dict[str, Any]:
+    return {"io.modelcontextprotocol/clientCapabilities": {"extensions": {TASKS_EXTENSION_ID: {}}}}
+
+
+def server_supports_tasks(initialize_result: Any) -> bool:
+    capabilities = getattr(initialize_result, "capabilities", None)
+    extensions = getattr(capabilities, "extensions", None)
+    return isinstance(extensions, dict) and TASKS_EXTENSION_ID in extensions
+
+
+def _needs_legacy_result_validation_bypass(session: Any) -> bool:
+    """Whether SDK 2.x would reject an extension result before parsing it.
+
+    MCP SDK 2.x validates every response against the negotiated core protocol
+    surface before applying the caller's ``result_type``.  Handshake-era
+    surfaces only admit ``CallToolResult`` for ``tools/call``, so a negotiated
+    extension result such as ``resultType=task`` is rejected even when the
+    caller deliberately requested a raw result model.  SDK 1.x does not expose
+    this dispatcher/stamp seam, and modern 2026 protocol surfaces already
+    tolerate non-core result tags for the SDK claim adapter.
+    """
+    try:
+        from mcp_types.version import HANDSHAKE_PROTOCOL_VERSIONS
+    except ImportError:
+        return False
+
+    version = getattr(session, "_negotiated_version", None)
+    dispatcher = getattr(session, "_dispatcher", None)
+    return (
+        version in HANDSHAKE_PROTOCOL_VERSIONS
+        and callable(getattr(session, "_stamp", None))
+        and callable(getattr(dispatcher, "send_raw_request", None))
+    )
+
+
+async def _send_legacy_extension_call(session: Any, request: Any) -> dict[str, Any]:
+    """Send one handshake-era extension call without SDK core-result validation.
+
+    This mirrors the transport preparation performed by MCP SDK 2.x
+    ``ClientSession.send_request`` (protocol stamp, request-class name metadata
+    handling and timeout),
+    but intentionally leaves result validation to :func:`call_tool`, whose
+    two accepted shapes are the ordinary SDK ``CallToolResult`` and the Tasks
+    extension handle.  The narrow bypass is used only after the server has
+    advertised the Tasks extension and only on legacy negotiated versions.
+    """
+    from mcp.shared.inbound import MCP_NAME_HEADER, encode_header_value
+
+    data = request.model_dump(by_alias=True, mode="json", exclude_none=True)
+    method = data["method"]
+    opts: dict[str, Any] = {}
+    session._stamp(data, opts)
+
+    headers = opts.setdefault("headers", {})
+    if (key := type(request).name_param) is not None and MCP_NAME_HEADER not in headers:
+        params_data = data.get("params") or {}
+        name = params_data.get(key)
+        if not isinstance(name, str):
+            raise ValueError(f"{method} requires params[{key!r}] for Mcp-Name")
+        headers[MCP_NAME_HEADER] = encode_header_value(name)
+
+    timeout = getattr(session, "_session_read_timeout_seconds", None)
+    if timeout is not None:
+        opts["timeout"] = timeout
+
+    raw = await session._dispatcher.send_raw_request(method, data.get("params"), opts)
+    ttl = raw.get("ttlMs") if isinstance(raw, dict) else None
+    if isinstance(ttl, (int, float)) and not isinstance(ttl, bool) and ttl < 0:
+        raw["ttlMs"] = 0
+    return raw
+
+
+async def add_task_routing_headers(request: Any) -> None:
+    """Add MCP 2026 task-routing headers to one Streamable HTTP request.
+
+    The installed SDK does not yet derive ``Mcp-Name`` / ``Mcp-Method`` from
+    custom extension requests, so Hermes adds them in an httpx request hook.
+    Non-task requests and unsafe header values are left untouched.
+    """
+    if str(getattr(request, "method", "")).upper() != "POST":
+        return
+    try:
+        body = await request.aread()
+        payload = json.loads(body)
+    except (AttributeError, TypeError, ValueError, json.JSONDecodeError):
+        return
+    method = str(payload.get("method") or "") if isinstance(payload, dict) else ""
+    params = payload.get("params") if isinstance(payload, dict) else None
+    task_id = str((params or {}).get("taskId") or "").strip() if isinstance(params, dict) else ""
+    if method not in TASK_ROUTING_METHODS or not task_id or "\r" in task_id or "\n" in task_id:
+        return
+    try:
+        task_id.encode("ascii")
+    except UnicodeEncodeError:
+        return
+    request.headers["Mcp-Name"] = task_id
+    request.headers["Mcp-Method"] = method
+
+
+async def call_tool(session: Any, name: str, arguments: dict[str, Any] | None) -> tuple[str, Any]:
+    from mcp import types
+
+    # SDK 2.x send_request() reads request-class protocol metadata such as
+    # name_param before serialization. A generic RootModel lacks that contract
+    # and fails locally with AttributeError before the request reaches the MCP
+    # server. Keep the raw *result* so a standard resultType=task remains
+    # parseable, but always use the SDK's official tools/call request model.
+    request = types.CallToolRequest(
+        params=types.CallToolRequestParams(
+            name=name,
+            arguments=arguments or {},
+            _meta=client_capability_meta(),
+        )
+    )
+    if _needs_legacy_result_validation_bypass(session):
+        raw = await _send_legacy_extension_call(session, request)
+    else:
+        raw = (await session.send_request(request, _RawResult)).root
+    if raw.get("resultType") == "task":
+        return "task", raw
+
+    result = types.CallToolResult.model_validate(raw)
+    if not _mcp_field(result, "is_error", "isError", False):
+        validate = getattr(session, "validate_tool_result", None)
+        if not callable(validate):
+            validate = getattr(session, "_validate_tool_result", None)
+        if callable(validate):
+            await validate(name, result)
+    return "complete", result
+
+
+async def _task_request_once(session: Any, method: str, params: dict[str, Any]) -> dict[str, Any]:
+    request = _RawRequest({"method": method, "params": params})
+    return (await session.send_request(request, _RawResult)).root
+
+
+def _suggested_task_id(exc: Exception, current_task_id: Any) -> str:
+    data = getattr(exc, "data", None)
+    if not isinstance(data, dict):
+        error = getattr(exc, "error", None)
+        data = getattr(error, "data", None)
+    if not isinstance(data, dict):
+        return ""
+    suggested = str(data.get("suggestedTaskId") or "").strip()
+    current = str(current_task_id or "").strip()
+    return suggested if suggested and suggested != current else ""
+
+
+async def task_request(session: Any, method: str, params: dict[str, Any]) -> dict[str, Any]:
+    try:
+        return await _task_request_once(session, method, params)
+    except Exception as exc:
+        # A server may identify that the caller supplied a job/case/run ID
+        # instead of the durable MCP taskId. Correct one read-only lookup when
+        # the server supplies an explicit, unambiguous task handle; never
+        # redirect cancellation or input mutation.
+        suggestion = _suggested_task_id(exc, params.get("taskId")) if method == "tasks/get" else ""
+        if not suggestion:
+            raise
+        corrected = dict(params)
+        corrected["taskId"] = suggestion
+        logger.warning(
+            "MCP %s corrected non-task ID %r to suggested taskId %r",
+            method,
+            params.get("taskId"),
+            suggestion,
+        )
+        return await _task_request_once(session, method, corrected)
