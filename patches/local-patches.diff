+class _ReadableHTMLParser(HTMLParser):
+    _SKIPPED_TAGS = {"script", "style", "noscript", "svg", "template"}
+    _BLOCK_TAGS = {
+        "address", "article", "aside", "blockquote", "br", "dd", "div", "dl",
+        "dt", "figcaption", "figure", "footer", "form", "h1", "h2", "h3", "h4",
+        "h5", "h6", "header", "hr", "li", "main", "nav", "ol", "p", "pre",
+        "section", "table", "tbody", "td", "tfoot", "th", "thead", "tr", "ul",
+    }
+
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.parts: list[str] = []
+        self._skip_depth = 0
+
+    def handle_starttag(self, tag: str, attrs) -> None:
+        tag = tag.lower()
+        if tag in self._SKIPPED_TAGS:
+            self._skip_depth += 1
+            return
+        if self._skip_depth:
+            return
+        if tag in self._BLOCK_TAGS:
+            self.parts.append("\n")
+        if tag == "li":
+            self.parts.append("- ")
+        if tag == "img":
+            alt = next((value for name, value in attrs if name.lower() == "alt"), None)
+            if alt:
+                self.parts.append(f"[Image: {alt}]")
+
+    def handle_startendtag(self, tag: str, attrs) -> None:
+        self.handle_starttag(tag, attrs)
+        if tag.lower() in self._SKIPPED_TAGS:
+            self.handle_endtag(tag)
+
+    def handle_endtag(self, tag: str) -> None:
+        tag = tag.lower()
+        if tag in self._SKIPPED_TAGS:
+            self._skip_depth = max(0, self._skip_depth - 1)
+            return
+        if not self._skip_depth and tag in self._BLOCK_TAGS:
+            self.parts.append("\n")
+
+    def handle_data(self, data: str) -> None:
+        if not self._skip_depth:
+            self.parts.append(data)
+
+
+def _decode_html(data: bytes) -> str:
+    if data.startswith((b"\xff\xfe", b"\xfe\xff")):
+        return data.decode("utf-16", errors="replace")
+    if data.startswith(b"\xef\xbb\xbf"):
+        return data.decode("utf-8-sig", errors="replace")
+    prefix = data[:4096]
+    match = re.search(
+        br"(?:charset\s*=\s*['\"]?\s*|encoding\s*=\s*['\"])([A-Za-z0-9._-]+)",
+        prefix,
+        flags=re.IGNORECASE,
+    )
+    encoding = match.group(1).decode("ascii", errors="ignore") if match else "utf-8"
+    try:
+        return data.decode(encoding, errors="replace")
+    except LookupError:
+        return data.decode("utf-8", errors="replace")
+
+
+def _extract_html_file(path: str) -> str:
+    try:
+        data = Path(path).read_bytes()
+    except OSError as exc:
+        raise ExtractionError(str(exc)) from exc
+    parser = _ReadableHTMLParser()
+    try:
+        parser.feed(_decode_html(data))
+        parser.close()
+    except Exception as exc:
+        raise ExtractionError(f"Unable to parse HTML: {exc}") from exc
+    text = "".join(parser.parts).replace("\r\n", "\n").replace("\r", "\n")
+    text = re.sub(r"[ \t\f\v]+", " ", text)
+    text = re.sub(r" *\n *", "\n", text)
+    text = re.sub(r"\n{3,}", "\n\n", text).strip()
+    if not text:
+        raise ExtractionError("HTML contains no extractable text")
+    return text + "\n"
+
+
+def _numbered_part_key(name: str) -> tuple[int, str]:
+    match = re.search(r"(\d+)(?=\.xml$)", name)
+    return (int(match.group(1)) if match else 0, name)
+
+
+def _extract_pptx(path: str) -> str:
+    try:
+        with zipfile.ZipFile(path) as zf:
+            _check_zip_safety(zf)
+            slide_names = sorted(
+                (
+                    name for name in zf.namelist()
+                    if re.fullmatch(r"ppt/slides/slide\d+\.xml", name)
+                ),
+                key=_numbered_part_key,
+            )
+            out: list[str] = []
+            for slide_number, name in enumerate(slide_names[:_MAX_PRESENTATION_SLIDES], start=1):
+                root = _zip_xml(zf, name)
+                a = f"{{{_NS_A}}}"
+                paragraphs = []
+                for paragraph in root.iter(f"{a}p"):
+                    text = "".join(node.text or "" for node in paragraph.iter(f"{a}t")).strip()
+                    if text:
+                        paragraphs.append(text)
+                out.append(f"# ── Slide {slide_number} ──")
+                out.extend(paragraphs or ["(no extractable text)"])
+                out.append("")
+            if len(slide_names) > _MAX_PRESENTATION_SLIDES:
+                out.append(f"[Presentation truncated after {_MAX_PRESENTATION_SLIDES} slides]")
+    except zipfile.BadZipFile as exc:
+        raise ExtractionError(f"Not a valid PPTX: {exc}") from exc
+    except OSError as exc:
+        raise ExtractionError(str(exc)) from exc
+    if not slide_names:
+        raise ExtractionError("PPTX contains no slides")
+    if not any(line and not line.startswith(("# ──", "(", "[")) for line in out):
+        raise ExtractionError("PPTX contains no extractable text")
+    return "\n".join(out).rstrip("\n") + "\n"
+
+
+def _extract_odt(path: str) -> str:
+    try:
+        with zipfile.ZipFile(path) as zf:
+            _check_zip_safety(zf)
+            root = _zip_xml(zf, "content.xml")
+    except zipfile.BadZipFile as exc:
+        raise ExtractionError(f"Not a valid ODT: {exc}") from exc
+    except OSError as exc:
+        raise ExtractionError(str(exc)) from exc
+    text = f"{{{_NS_TEXT}}}"
+    lines = []
+    for node in root.iter():
+        if node.tag not in {f"{text}h", f"{text}p"}:
+            continue
+        line = "".join(node.itertext()).strip()
+        if line:
+            lines.append(line)
+    if not lines:
+        raise ExtractionError("ODT contains no extractable text")
+    return "\n".join(lines).rstrip("\n") + "\n"
+
+
