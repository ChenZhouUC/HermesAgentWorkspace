+            b"mif1", b"msf1", b"heim", b"heis",
+        }:
+            return None
+        if brand == b"qt  ":
+            return "video/mov"
+        if brand.startswith(b"3gp"):
+            return "video/3gpp"
+        return "video/mp4"
