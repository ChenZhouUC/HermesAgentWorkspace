+    model: str,
+    after_first_byte: bool,
+    hint: Optional[str] = None,
+) -> str:
+    """Build the buffered Codex reconnect notice consumed by chat filters."""
+    if after_first_byte:
+        notice = (
+            f"⚠️ Codex stream sent no events for {int(elapsed)}s "
+            f"after first byte (model: {model}). Reconnecting."
+        )
+    else:
+        notice = (
+            f"⚠️ No first byte from provider in {int(elapsed)}s "
+            f"(codex stream, model: {model}). Reconnecting."
+        )
+    return f"{notice} {hint}" if hint else notice
+
+
