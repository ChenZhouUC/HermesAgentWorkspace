+    """Video-input capability for provider/model pairs known to accept it.
+
+    Vertex's OpenAI-compatible endpoint accepts any GenerateContent MIME as
+    a base64 ``data:`` URI inside an ``image_url`` part, and Gemini 3.x
+    understands video natively. Image vision support
+    (``_lookup_supports_vision``) must NOT be used as a proxy here — most
+    vision-capable models cannot take video, and there is no models.dev-style
+    catalog for video input, so keep this allowlist narrow.
+    """
+    p = (provider or "").strip().lower()
+    m = (model or "").strip().lower()
+    if not p or not m:
+        return None
+    if p in {"vertex", "google-vertex", "vertex-ai", "vertexai"}:
+        if "gemini-3" in m or "gemini-pro-3" in m or "gemini-flash-3" in m:
+            return True
+    return None
+
