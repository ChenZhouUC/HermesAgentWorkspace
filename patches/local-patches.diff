+def _sniff_video_mime_from_bytes(raw: bytes) -> Optional[str]:
+    """Detect video MIME from magic bytes. Returns None if unrecognised."""
+    if not raw or len(raw) < 12:
+        return None
+    # ISO-BMFF family (MP4/MOV/3GPP): size(4) + 'ftyp' + major brand. Image
+    # brands (HEIC/AVIF) live in the same container — leave those to the
+    # image sniffer.
+    if raw[4:8] == b"ftyp":
+        brand = raw[8:12]
+        if brand in {
+            b"avif", b"avis", b"heic", b"heix", b"hevc", b"hevx",
+            b"mif1", b"msf1", b"heim", b"heis",
+        }:
+            return None
+        if brand == b"qt  ":
+            return "video/mov"
+        if brand.startswith(b"3gp"):
+            return "video/3gpp"
+        return "video/mp4"
+    # EBML (Matroska/WebM): DocType string sits within the first header bytes.
+    if raw[:4] == b"\x1a\x45\xdf\xa3":
+        return "video/webm" if b"webm" in raw[:64] else "video/x-matroska"
+    # RIFF AVI
+    if raw[:4] == b"RIFF" and raw[8:12] == b"AVI ":
+        return "video/avi"
+    # FLV
+    if raw[:3] == b"FLV":
+        return "video/x-flv"
+    # ASF (WMV)
+    if raw[:4] == b"\x30\x26\xb2\x75":
+        return "video/wmv"
+    # MPEG program stream / video sequence
+    if raw[:4] in {b"\x00\x00\x01\xba", b"\x00\x00\x01\xb3"}:
+        return "video/mpeg"
+    return None
+
+
+def _guess_video_mime(path: Path, raw: Optional[bytes] = None) -> str:
+    """Return video MIME type for *path* (magic bytes win, then suffix)."""
+    if raw is not None:
+        sniffed = _sniff_video_mime_from_bytes(raw)
+        if sniffed:
+            return sniffed
+    mime, _ = mimetypes.guess_type(str(path))
+    if mime and mime.startswith("video/"):
+        return mime
+    return _VIDEO_MIME_BY_SUFFIX.get(path.suffix.lower(), "video/mp4")
+
