+    def test_promote_block_markdown_fixes_strong_flanking(self):
+        """CommonMark flanking: ``到**“x”**的`` cannot open/close, so Feishu
+        shows the raw asterisks. Edge punctuation is moved outside the markers
+        (verified against real Feishu clients, 2026-07-25)."""
+        from plugins.platforms.feishu.adapter import _promote_block_markdown
+
+        self.assertEqual(
+            _promote_block_markdown("切入到**“端云通信协议”**的深水区"),
+            "切入到“**端云通信协议**”的深水区",
+        )
+        # Only the failing edge is rewritten; a legal closing edge stays put.
+        self.assertEqual(
+            _promote_block_markdown("它是一个**“规范（Spec）”**。"),
+            "它是一个“**规范（Spec）”**。",
+        )
+        # All-punctuation span cannot be salvaged — markers are dropped.
+        self.assertEqual(_promote_block_markdown("到**“……”**"), "到“……”")
+
+    def test_promote_block_markdown_keeps_legal_strong_spans(self):
+        from plugins.platforms.feishu.adapter import _promote_block_markdown
+
+        for legal in (
+            "**总结：**",  # line boundaries count as whitespace
+            "中文，**紧贴标点**。",  # punctuation outside is a valid boundary
+            "2. **“引号边缘”** 后续",  # whitespace outside is a valid boundary
+            "组\n****嵌套加粗****\n尾",  # nested strong renders natively
+            "看 `到**“代码”**的` 保持原样",  # inline code is untouched
+        ):
+            self.assertEqual(_promote_block_markdown(legal), legal)
+        # Fast path still returns the identical object when nothing changes.
+        plain = "支持 **粗体** 和 `代码`\n- 列表"
