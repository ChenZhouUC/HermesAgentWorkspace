+    if raw.startswith(b"OggS"):
+        return "audio/ogg"
+    if raw.startswith(b"ID3") or raw[:2] in {b"\xff\xfb", b"\xff\xf3", b"\xff\xf2"}:
+        return "audio/mpeg"
+    if len(raw) >= 12 and raw[4:8] == b"ftyp":
+        return "audio/mp4"
+    return None
+
+def _guess_audio_mime(path: Path, raw: Optional[bytes] = None) -> str:
+    """Return audio MIME type for *path* (magic bytes win, then suffix)."""
+    if raw is not None:
