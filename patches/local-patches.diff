+        consumer.on_delta(body)
+        consumer.finish()
+        await consumer.run()
+
+        delivered = "".join(_sent_and_edited(adapter))
+        assert "NO_REPLY" in delivered
+        assert consumer.final_content_delivered is True
+
+    @pytest.mark.asyncio
+    async def test_text_filter_applies_before_stream_delivery(self):
+        """Gateway-level privacy filters must also cover token streaming."""
+        adapter = _make_adapter()
+        consumer = GatewayStreamConsumer(
+            adapter, "chat_1",
+            StreamConsumerConfig(edit_interval=0.01, buffer_threshold=1),
+            text_filter=lambda text: text.replace("PRIVATE_PROFILE", "[redacted]"),
+        )
+        consumer.on_delta("Visible PRIVATE_PROFILE content.")
+        consumer.finish()
+        await consumer.run()
+
+        delivered = "".join(_sent_and_edited(adapter))
