+def pick_multimodal_sidecar_route(
+    cfg: Optional[Dict[str, Any]],
+    kind: str,
+) -> Optional[Tuple[str, str]]:
+    """Return the first configured route verified for ``kind`` input.
+
+    ``kind`` is ``image``, ``audio``, ``video``, or ``document``. The caller sends only the
+    current media plus bounded caption/reply context to this one-shot route and
+    feeds its textual reading back into the main session. The main provider,
+    transcript, tools, and session identity never switch.
+
+    Order follows the effective fallback chain (``get_fallback_chain``) so the
+    sidecar honours the same provider preference the user already configured
+    for degraded operation, rather than a second hardcoded allowlist. The main
+    provider/model is checked first — when it can read video there is no
+    sidecar to pick and the native path handles it.
+    """
+    if not isinstance(cfg, dict):
+        return None
+    kind = (kind or "").strip().lower()
+    if kind not in {"image", "audio", "video", "document"}:
+        return None
+
+    # Gateway config reads use raw YAML for speed. Expand model references here
+    # so sidecar selection sees the same identities as the runtime provider.
+    try:
+        from hermes_cli.config import _expand_env_vars
+
+        cfg = _expand_env_vars(cfg)
+    except Exception:
+        pass
+
+    candidates: List[Tuple[str, str]] = []
+    model_cfg = cfg.get("model")
+    if isinstance(model_cfg, dict):
+        candidates.append(
+            (
+                str(model_cfg.get("provider") or "").strip(),
+                str(model_cfg.get("default") or "").strip(),
+            )
+        )
+    try:
+        from hermes_cli.fallback_config import get_fallback_chain
+
+        for entry in get_fallback_chain(cfg):
+            if isinstance(entry, dict):
+                candidates.append(
+                    (
+                        str(entry.get("provider") or "").strip(),
+                        str(entry.get("model") or "").strip(),
+                    )
+                )
+    except Exception:
+        # A malformed fallback chain must not break video handling; the main
+        # entry above is still a valid candidate.
+        pass
+
+    for provider, model in candidates:
+        if not provider or not model:
+            continue
+        if _known_provider_model_supports_media(provider, model, kind) is True:
+            return provider, model
+    return None
+
