+    def _new_attachment_download_budget(
+        self,
+        *,
+        max_files: Optional[int] = None,
+        deadline: Optional[float] = None,
+    ) -> _AttachmentDownloadBudget:
+        if deadline is None:
+            deadline = (
+                asyncio.get_running_loop().time()
+                + float(
+                    getattr(
+                        self,
+                        "_attachment_backfill_timeout_seconds",
+                        _FEISHU_BACKFILL_TIMEOUT_SECONDS,
+                    )
+                )
+            )
+        return _AttachmentDownloadBudget(
+            remaining=self._attachment_file_budget(max_files),
+            deadline=deadline,
+        )
