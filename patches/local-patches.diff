+                getattr(
+                    self,
+                    "_attachment_backfill_window_seconds",
+                    _FEISHU_BACKFILL_WINDOW_SECONDS,
+                )
+            ),
+        )
+        request = self._build_list_message_request(
+            chat_id=chat_id,
+            start_time=str(start_ts),
+            end_time=str(end_ts),
+            page_size=50,
+        )
+        response = await asyncio.to_thread(self._client.im.v1.message.list, request)
+        if not response or getattr(response, "success", lambda: False)() is False:
+            code = getattr(response, "code", "unknown")
+            msg = getattr(response, "msg", "message list failed")
+            logger.warning("[Feishu] backfill list failed for %s: [%s] %s", chat_id, code, msg)
+            raise RuntimeError(f"message list failed: [{code}] {msg}")
+        items = getattr(getattr(response, "data", None), "items", None) or []
+
+        # items arrive ByCreateTimeDesc (newest first); take this sender's recent
+        # image/file messages up to the per-turn cap, skipping already-stitched ones.
+        picked: List[Any] = []
+        for item in items:
+            if len(picked) >= int(
+                getattr(
+                    self,
+                    "_attachment_backfill_max_messages",
+                    _FEISHU_BACKFILL_MAX_ATTACH_MSGS,
+                )
+            ):
+                break
+            if getattr(item, "deleted", False):
+                continue
+            msg_id = str(getattr(item, "message_id", "") or "")
+            if not msg_id or msg_id == str(trigger_message_id):
+                continue
+            if msg_id in self._backfilled_attachment_ids:
+                continue
+            sender = getattr(item, "sender", None)
+            if str(getattr(sender, "id", "") or "") not in wanted_senders:
+                continue
+            if str(getattr(item, "msg_type", "") or "") not in _FEISHU_BACKFILL_MSG_TYPES:
+                continue
