+    @patch.dict(os.environ, {}, clear=True)
+    def test_quote_chain_root_id_does_not_become_thread_id_or_split_session(self):
+        """PATCH-FEISHU-QUOTE-CHAIN-SESSION: root_id must not leak into thread_id.
+
+        ``root_id`` is the quote-chain root, not a Feishu topic id, and every
+        un-quoted group message starts a new one. The old inbound conflation
+        (``thread_id or root_id``) appended it to the session key, so each quote
+        chain silently split the group into a fresh session — reloading skills
+        and history backfill from scratch every time. Asserts the real
+        session-key builder returns the plain group key, and that the quote
+        chain is still carried by reply_to_message_id/reply_to_text.
+        """
+        from gateway.config import PlatformConfig
+        from gateway.platforms.base import MessageType
+        from gateway.session import build_session_key
+        from plugins.platforms.feishu.adapter import FeishuAdapter
+
+        adapter = FeishuAdapter(PlatformConfig())
+        adapter._dispatch_inbound_event = AsyncMock()
+        adapter._message_trigger_kind = Mock(return_value="bot")
+        adapter._extract_message_content = AsyncMock(
+            return_value=("根据这个信息再 sourcing 一下", MessageType.TEXT, [], [], [])
+        )
+        adapter._fetch_channel_context = AsyncMock(return_value=None)
+        adapter._fetch_message_text = AsyncMock(return_value="被引用的原消息")
+        adapter.get_chat_info = AsyncMock(
+            return_value={"chat_id": "oc_grp", "name": "Group", "type": "group"}
+        )
+        adapter._resolve_sender_profile = AsyncMock(
+            return_value={"user_id": "ou_alice", "user_name": "Alice", "user_id_alt": None}
+        )
+        # A real quote-reply: Feishu populates root_id/parent_id, thread_id stays
+        # None because the topic lane is unused.
+        message = SimpleNamespace(
+            chat_id="oc_grp",
+            thread_id=None,
+            parent_id="om_quoted",
+            upper_message_id=None,
+            root_id="om_chain_root",
+            message_type="text",
+            content='{"text":"根据这个信息再 sourcing 一下"}',
+            message_id="om_reply",
+        )
+
+        asyncio.run(
+            adapter._process_inbound_message(
+                data=SimpleNamespace(event=SimpleNamespace(message=message)),
+                message=message,
+                sender_id=SimpleNamespace(open_id="ou_alice", user_id=None, union_id=None),
+                is_bot=False,
+                chat_type="group",
+                message_id="om_reply",
+            )
+        )
+
+        adapter._dispatch_inbound_event.assert_awaited_once()
+        event = adapter._dispatch_inbound_event.await_args.args[0]
+
+        # The quote-chain root must NOT have been promoted to a topic id.
+        self.assertIsNone(event.source.thread_id)
+
+        # Behavioral proof: the real key builder yields the plain group key, so
+        # every quote chain in this group resolves to ONE session.
+        key = build_session_key(event.source, group_sessions_per_user=False)
+        self.assertEqual(key, "agent:main:feishu:group:oc_grp")
+        self.assertNotIn("om_chain_root", key)
+
+        # The quote chain itself is still delivered — this fix removes the
+        # session split, not the ability to follow a quote.
+        self.assertEqual(event.reply_to_message_id, "om_quoted")
+        self.assertEqual(event.reply_to_text, "被引用的原消息")
+
