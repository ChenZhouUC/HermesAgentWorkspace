@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+import asyncio
+
+from tools.mcp_tasks_extension import (
+    TASKS_EXTENSION_ID,
+    call_tool,
+    server_supports_tasks,
+    task_request,
+)
+
+
+class _Session:
+    def __init__(self, response):
+        self.response = response
+        self.requests = []
+        self.validated = []
+
+    async def send_request(self, request, result_type):
+        self.requests.append(request.model_dump(mode="json"))
+        return result_type.model_validate(self.response)
+
+    async def _validate_tool_result(self, name, result):
+        self.validated.append((name, result))
+
+
+def test_task_aware_call_advertises_extension_and_accepts_task_handle():
+    session = _Session({
+        "resultType": "task",
+        "taskId": "42",
+        "status": "working",
+        "createdAt": "2026-08-18T00:00:00Z",
+        "lastUpdatedAt": "2026-08-18T00:00:00Z",
+        "ttlMs": None,
+    })
+
+    kind, result = asyncio.run(call_tool(session, "start", {"x": 1}))
+
+    assert kind == "task"
+    assert result["taskId"] == "42"
+    meta = session.requests[0]["params"]["_meta"]
+    assert meta["io.modelcontextprotocol/clientCapabilities"]["extensions"] == {
+        TASKS_EXTENSION_ID: {}
+    }
+    assert session.validated == []
+
+
+def test_task_aware_call_preserves_standard_call_tool_result_validation():
+    session = _Session({
+        "content": [{"type": "text", "text": "done"}],
+        "isError": False,
+    })
+
+    kind, result = asyncio.run(call_tool(session, "read", {}))
+
+    assert kind == "complete"
+    assert result.content[0].text == "done"
+    assert session.validated[0][0] == "read"
+
+
+def test_task_request_uses_standard_method_and_task_id():
+    session = _Session({
+        "resultType": "complete",
+        "taskId": "42",
+        "status": "working",
+        "createdAt": "2026-08-18T00:00:00Z",
+        "lastUpdatedAt": "2026-08-18T00:00:00Z",
+        "ttlMs": None,
+    })
+
+    result = asyncio.run(task_request(session, "tasks/get", {"taskId": "42"}))
+
+    assert result["taskId"] == "42"
+    assert session.requests[0] == {
+        "method": "tasks/get",
+        "params": {"taskId": "42"},
+    }
+
+
+def test_server_support_is_driven_by_negotiated_extension():
+    class _Caps:
+        extensions = {TASKS_EXTENSION_ID: {}}
+
+    class _Init:
+        capabilities = _Caps()
+
+    assert server_supports_tasks(_Init()) is True
