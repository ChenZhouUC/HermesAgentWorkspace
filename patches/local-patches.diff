+def _known_provider_model_supports_media(
+    provider: str,
+    model: str,
+    kind: str,
+) -> Optional[bool]:
+    """Return verified support for a sidecar input modality."""
+    normalized = (kind or "").strip().lower()
+    if normalized == "image":
+        return _known_provider_model_supports_vision(provider, model)
+    if normalized == "audio":
+        return _known_provider_model_supports_audio(provider, model)
+    if normalized == "video":
+        return _known_provider_model_supports_video(provider, model)
+    if normalized == "document":
+        return _known_provider_model_supports_document(provider, model)
+    return None
