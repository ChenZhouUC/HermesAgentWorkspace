+    @staticmethod
+    def _history_sender_person(sender_id: str) -> Optional[Dict[str, Any]]:
+        """Join a history sender id against ~/.hermes/people.yaml.
+
+        Reuses the gateway profile index (open_id/user_id/union_id/name/aliases),
+        so history labels stay consistent with the current-author profile block.
+        Any failure degrades to no match rather than breaking history rendering.
+        """
+        if not sender_id:
+            return None
+        try:
+            from gateway.session import _lookup_person
+
+            return _lookup_person(sender_id)
+        except Exception:  # missing/malformed people.yaml, import cycle, etc.
+            return None
+
+    @staticmethod
+    def _history_person_qualifier(person: Dict[str, Any]) -> str:
+        """Render only the public-facing identity fields for a history sender.
+
+        Deliberately limited to role/department: history is echoed into group
+        replies, and everything outside the public four (name, address, role,
+        team) stays confidential per the people.yaml disclosure boundary.
+        """
+        parts: List[str] = []
+        for field_name in ("role", "department"):
+            value = " ".join(str(person.get(field_name) or "").split())
+            if value and value not in parts:
+                parts.append(value)
+        return " · ".join(parts)
