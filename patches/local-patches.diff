+    default ``auto``). In auto mode only the narrow allowlist above goes
+    native; there is no reactive shrink-and-retry salvage for video, so an
+    optimistic default would fail whole turns on providers that reject it.
+    """
+    mode_cfg = "auto"
+    if isinstance(cfg, dict):
+        agent_cfg = cfg.get("agent") or {}
+        if isinstance(agent_cfg, dict):
+            mode_cfg = _coerce_mode(agent_cfg.get("video_input_mode"))
