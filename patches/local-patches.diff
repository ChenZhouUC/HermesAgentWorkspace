+            "▎ **“元层逻辑是否循环？”**",
+        )
+        # Fenced code is exempt from the flanking rewrite.
+        src = "```\n到**“注释”**的\n```\n到**“正文”**的"
+        self.assertEqual(
+            _promote_block_markdown(src),
+            "```\n到**“注释”**的\n```\n到“**正文**”的",
