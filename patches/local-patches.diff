+        max_files: Optional[int] = None,
+        deadline: Optional[float] = None,
+        budget: Optional[_AttachmentDownloadBudget] = None,
+    ) -> Optional[tuple[List[str], List[str]]]:
+        download_budget = budget or self._new_attachment_download_budget(
+            max_files=max_files,
+            deadline=deadline,
+        )
+        initial_budget = download_budget.remaining
+        if initial_budget <= 0:
+            return None
+        request = self._build_get_message_request(reply_to_message_id)
+        response = await self._run_blocking(self._client.im.v1.message.get, request)
+        if not response or getattr(response, "success", lambda: False)() is False:
+            raise RuntimeError("quoted message lookup failed")
+        items = getattr(getattr(response, "data", None), "items", None) or []
+        media_urls: List[str] = []
+        media_types: List[str] = []
+        found_resources = False
+        for item in items:
+            item_message_id = str(getattr(item, "message_id", "") or "")
+            # ``items`` holds the quoted message plus, for a merge_forward, its
+            # children (linked by upper_message_id). Accept both so attachments
+            # inside a quoted forwarded transcript are downloaded too.
+            is_target = item_message_id == reply_to_message_id
+            is_forward_child = (
+                str(getattr(item, "upper_message_id", "") or "") == reply_to_message_id
+            )
+            if not (is_target or is_forward_child):
+                continue
+            body = getattr(item, "body", None)
+            normalized = normalize_feishu_message(
+                message_type=str(getattr(item, "msg_type", "") or ""),
+                raw_content=str(getattr(body, "content", "") or ""),
+                mentions=getattr(item, "mentions", None),
+                bot=self._bot_identity(),
+            )
+            if not (normalized.image_keys or normalized.media_refs):
+                continue
+            found_resources = True
+            if download_budget.remaining <= 0:
+                break
+            urls, types = await self._download_feishu_message_resources(
+                message_id=item_message_id or reply_to_message_id,
+                normalized=normalized,
+                max_files=download_budget.remaining,
+                deadline=download_budget.deadline,
+                budget=download_budget,
+            )
+            media_urls.extend(urls)
+            media_types.extend(types)
+        if not media_urls:
+            if found_resources:
+                raise RuntimeError(
+                    "quoted attachment messages were found but none could be downloaded"
+                )
+            return None
