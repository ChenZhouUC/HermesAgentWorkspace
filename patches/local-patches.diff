+def _known_provider_model_supports_document(
+    provider: str,
+    model: str,
+) -> Optional[bool]:
+    """PDF/text-file input capability verified for Gemini 3.x on Vertex."""
+    p = (provider or "").strip().lower()
+    m = (model or "").strip().lower()
+    if not p or not m:
+        return None
+    if p in {"vertex", "google-vertex", "vertex-ai", "vertexai"}:
+        if "gemini-3" in m or "gemini-pro-3" in m or "gemini-flash-3" in m:
+            return True
+    return None
