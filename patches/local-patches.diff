+# Feishu's post ``md`` renderer enforces CommonMark emphasis flanking rules: a
+# ``**`` run cannot open when the character just inside is punctuation while
+# the character just outside is a letter or digit, and cannot close in the
+# mirrored case. Chinese prose hits this constantly (``到**“协议”**的`` — CJK
+# typography puts no spaces around quotes), leaving the raw asterisks visible.
+# Such spans are rewritten by moving the offending edge punctuation outside
+# the markers (``到“**协议**”的``), which satisfies the flanking rules and is
+# visually equivalent.
+_STRONG_SPAN_RE = re.compile(r"\*\*([^*\n]+?)\*\*")
+_INLINE_CODE_SPAN_RE = re.compile(r"(`[^`\n]*`)")
