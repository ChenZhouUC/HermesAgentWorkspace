+    def _schedule_missed_event_backfill_from_thread(self, reason: str) -> None:
+        loop = getattr(self, "_loop", None)
+        if not self._loop_accepts_callbacks(loop):
+            return
+        try:
+            loop.call_soon_threadsafe(self._schedule_missed_event_backfill, reason)
+        except RuntimeError:
+            logger.debug("[Feishu] Could not schedule missed-event backfill; loop unavailable")
+
+    async def _run_missed_event_backfill(self, reason: str) -> None:
+        """Replay recently missed Feishu messages from known chats after reconnect/startup."""
+        if not getattr(self, "_missed_event_backfill", True) or getattr(self, "_client", None) is None:
+            return
+        chat_ids = self._missed_event_backfill_target_chat_ids()
+        if not chat_ids:
+            logger.debug("[Feishu] Missed-event backfill skipped: no target chats configured")
+            return
+        end_ts = int(time.time())
+        start_ts = max(0, end_ts - int(getattr(self, "_missed_event_backfill_seconds", 0) or 0))
+        page_size = min(
+            max(1, int(getattr(self, "_missed_event_backfill_limit", _DEFAULT_MISSED_EVENT_BACKFILL_LIMIT) or 1)),
+            _MISSED_EVENT_BACKFILL_MAX_PAGE_SIZE,
+        )
+        scanned = 0
+        admitted = 0
+        for chat_id in chat_ids:
+            result = await self._backfill_missed_events_for_chat(
+                chat_id=chat_id,
+                start_ts=start_ts,
+                end_ts=end_ts,
+                page_size=page_size,
+            )
+            scanned += result.get("scanned", 0)
+            admitted += result.get("admitted", 0)
+        logger.info(
+            "[Feishu] Missed-event backfill complete after %s: chats=%d scanned=%d admitted=%d window=%ss",
+            reason,
+            len(chat_ids),
+            scanned,
+            admitted,
+            end_ts - start_ts,
+        )
+
+    def _missed_event_backfill_target_chat_ids(self) -> list[str]:
+        ordered: list[str] = []
+
+        def add(chat_id: Any) -> None:
+            value = str(chat_id or "").strip()
+            if value and value not in ordered:
+                ordered.append(value)
+
+        for chat_id in getattr(self, "_missed_event_backfill_chats", set()) or set():
+            add(chat_id)
+
+        home_channel = getattr(getattr(self, "config", None), "home_channel", None)
+        add(getattr(home_channel, "chat_id", None))
+
+        for chat_id in (getattr(self, "_group_rules", {}) or {}).keys():
+            if str(chat_id).strip() != "*":
+                add(chat_id)
+
+        for chat_id in self._load_groups_yaml_chat_ids():
+            add(chat_id)
+        return ordered
+
+    @staticmethod
+    def _load_groups_yaml_chat_ids() -> list[str]:
+        groups_path = get_hermes_home() / "groups.yaml"
+        try:
+            import yaml
+
+            payload = yaml.safe_load(groups_path.read_text(encoding="utf-8")) or {}
+        except FileNotFoundError:
+            return []
+        except Exception:
+            logger.debug("[Feishu] Failed to read groups.yaml for missed-event backfill", exc_info=True)
+            return []
+        groups = payload.get("groups") if isinstance(payload, dict) else None
+        if not isinstance(groups, list):
+            return []
+        chat_ids: list[str] = []
+        for group in groups:
+            if isinstance(group, dict):
+                chat_id = str(group.get("chat_id") or "").strip()
+                if chat_id:
+                    chat_ids.append(chat_id)
+        return chat_ids
+
+    async def _backfill_missed_events_for_chat(
+        self,
+        *,
+        chat_id: str,
+        start_ts: int,
+        end_ts: int,
+        page_size: int,
+    ) -> Dict[str, int]:
+        if not chat_id or getattr(self, "_client", None) is None:
+            return {"scanned": 0, "admitted": 0}
+        request = self._build_list_message_request(
+            chat_id=chat_id,
+            start_time=str(start_ts),
+            end_time=str(end_ts),
+            page_size=page_size,
+        )
+        try:
+            response = await self._run_blocking(self._client.im.v1.message.list, request)
+        except Exception:
+            logger.warning("[Feishu] Missed-event backfill list failed for %s", chat_id, exc_info=True)
+            return {"scanned": 0, "admitted": 0}
+        if not response or getattr(response, "success", lambda: False)() is False:
+            code = getattr(response, "code", "unknown")
+            msg = getattr(response, "msg", "message list failed")
+            logger.warning("[Feishu] Missed-event backfill list failed for %s: [%s] %s", chat_id, code, msg)
+            return {"scanned": 0, "admitted": 0}
+
+        items = getattr(getattr(response, "data", None), "items", None) or []
+        if not items:
+            return {"scanned": 0, "admitted": 0}
+        # message.list items carry no chat_type; resolve it from chat metadata
+        # (chat_mode: p2p/group/topic) so DM (home-channel) replays admit like
+        # live p2p events. Fail closed to "group": a failed/fallback lookup
+        # must never lift the mention gate or group policy for a real group.
+        chat_info = await self.get_chat_info(chat_id)
+        event_chat_type = "p2p" if chat_info.get("raw_mode") == "p2p" else "group"
+        scanned = 0
+        admitted = 0
+        for item in sorted(
+            items,
+            key=lambda msg: self._coerce_feishu_epoch_seconds(getattr(msg, "create_time", None)) or 0,
+        ):
+            if getattr(item, "deleted", False):
+                continue
+            message_id = str(getattr(item, "message_id", "") or "").strip()
+            if not message_id or self._has_seen_message_id(message_id):
+                continue
+            scanned += 1
+            event_data = self._history_item_to_event_data(
+                item, chat_id=chat_id, chat_type=event_chat_type,
+            )
+            message = getattr(getattr(event_data, "event", None), "message", None)
+            sender = getattr(getattr(event_data, "event", None), "sender", None)
+            if not message or not sender:
+                continue
+            reason = self._admit(sender, message)
+            if reason is not None:
+                logger.debug("[Feishu] Missed-event backfill skipped %s: %s", message_id, reason)
+                continue
+            await self._handle_message_event_data(event_data)
+            admitted += 1
+        return {"scanned": scanned, "admitted": admitted}
+
+    def _history_item_to_event_data(self, item: Any, *, chat_id: str, chat_type: str) -> Any:
+        body = getattr(item, "body", None)
+        message_type = str(getattr(item, "msg_type", "") or getattr(item, "message_type", "") or "")
+        sender = getattr(item, "sender", None)
+        message = SimpleNamespace(
+            message_id=str(getattr(item, "message_id", "") or ""),
+            chat_id=chat_id,
+            chat_type=chat_type,
+            message_type=message_type,
+            content=str(getattr(body, "content", "") or getattr(item, "content", "") or ""),
+            mentions=getattr(item, "mentions", None) or [],
+            create_time=getattr(item, "create_time", None),
+            parent_id=getattr(item, "parent_id", None),
+            upper_message_id=getattr(item, "upper_message_id", None),
+            root_id=getattr(item, "root_id", None),
+            thread_id=getattr(item, "thread_id", None),
+        )
+        sender_ns = SimpleNamespace(
+            sender_type=str(getattr(sender, "sender_type", "") or "user"),
+            sender_id=self._history_sender_id_namespace(sender),
+        )
+        return SimpleNamespace(event=SimpleNamespace(message=message, sender=sender_ns))
+
+    @staticmethod
+    def _history_sender_id_namespace(sender: Any) -> Any:
+        sender_id = str(getattr(sender, "id", "") or "").strip()
+        id_type = str(getattr(sender, "id_type", "") or "").strip().lower()
+        if id_type == "user_id" or sender_id.startswith("u_"):
+            return SimpleNamespace(open_id=None, user_id=sender_id, union_id=None)
+        if id_type == "union_id" or sender_id.startswith("on_"):
+            return SimpleNamespace(open_id=None, user_id=None, union_id=sender_id)
+        return SimpleNamespace(open_id=sender_id or None, user_id=None, union_id=None)
+
+    @staticmethod
+    def _coerce_feishu_epoch_seconds(value: Any) -> Optional[int]:
+        try:
+            parsed = int(value)
+        except (TypeError, ValueError):
+            return None
+        if parsed <= 0:
+            return None
+        # Feishu message create_time values are commonly milliseconds.
+        if parsed > 10_000_000_000:
+            parsed //= 1000
+        return parsed
