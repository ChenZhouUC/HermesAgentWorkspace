+def test_tasks_get_retries_one_explicit_server_suggested_task_id():
+    from mcp.shared.exceptions import MCPError
+
+    class RepairSession(_Session):
+        async def send_request(self, request, result_type):
+            dumped = request.model_dump(by_alias=True, mode="json", exclude_none=True)
+            self.requests.append(dumped)
+            if len(self.requests) == 1:
+                raise MCPError(
+                    -32602,
+                    'taskId "99" was not found; use taskId "8"',
+                    data={"receivedKind": "job", "suggestedTaskId": "8"},
