+from tools.mcp_tasks_extension import (
+    TASKS_EXTENSION_ID,
+    add_task_routing_headers,
+    call_tool,
+    server_supports_tasks,
+    task_request,
+)
+
+
+class _Session:
+    def __init__(self, response):
+        self.response = response
+        self.requests = []
+        self.request_types = []
+        self.request_name_params = []
+        self.validated = []
+
+    async def send_request(self, request, result_type):
+        # Mirror the MCP SDK 2.x pre-dispatch contract. A generic Pydantic
+        # RootModel without name_param must fail here just as the real SDK does.
+        self.request_types.append(type(request))
+        self.request_name_params.append(type(request).name_param)
+        self.requests.append(request.model_dump(by_alias=True, mode="json", exclude_none=True))
+        return result_type.model_validate(self.response)
+
+    async def validate_tool_result(self, name, result):
+        self.validated.append((name, result))
+
+
+class _LegacySession(_Session):
+    validate_tool_result = None
+
+    async def _validate_tool_result(self, name, result):
+        self.validated.append((name, result))
+
+
+class _SDK2Dispatcher:
+    def __init__(self, response):
+        self.response = response
+        self.calls = []
+
+    async def send_raw_request(self, method, params, opts):
+        self.calls.append((method, params, opts))
+        return self.response.copy()
+
+
+def _legacy_sdk2_session(response):
+    from mcp import ClientSession, types
+
+    dispatcher = _SDK2Dispatcher(response)
+    session = ClientSession(dispatcher=dispatcher)
+    session.adopt(types.InitializeResult(
+        protocolVersion="2025-11-25",
+        capabilities=types.ServerCapabilities(extensions={TASKS_EXTENSION_ID: {}}),
+        serverInfo=types.Implementation(name="demo", version="1"),
+    ))
+    return session, dispatcher
+
+
+def test_task_aware_call_advertises_extension_and_accepts_task_handle():
+    session = _Session({
+        "resultType": "task",
+        "taskId": "42",
+        "status": "working",
+        "createdAt": "2026-08-18T00:00:00Z",
+        "lastUpdatedAt": "2026-08-18T00:00:00Z",
+        "ttlMs": None,
+    })
+
+    kind, result = asyncio.run(call_tool(session, "start", {"x": 1}))
+
+    assert kind == "task"
+    assert result["taskId"] == "42"
+    meta = session.requests[0]["params"]["_meta"]
+    assert meta["io.modelcontextprotocol/clientCapabilities"]["extensions"] == {TASKS_EXTENSION_ID: {}}
+    assert session.validated == []
+
+
+def test_task_aware_call_uses_sdk_request_model_with_name_metadata():
+    from mcp import types
+
+    session = _Session({
+        "resultType": "task",
+        "taskId": "42",
+        "status": "working",
+        "createdAt": "2026-08-18T00:00:00Z",
+        "lastUpdatedAt": "2026-08-18T00:00:00Z",
+        "ttlMs": None,
+    })
+
+    asyncio.run(call_tool(session, "start", {}))
+
+    assert session.request_types == [types.CallToolRequest]
+    assert session.request_name_params == [types.CallToolRequest.name_param]
+
+
+def test_task_aware_call_bypasses_sdk2_legacy_core_result_prevalidation():
+    session, dispatcher = _legacy_sdk2_session({
