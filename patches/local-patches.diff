 # ---------------------------------------------------------------------------
 # Post payload builders and parsers
 # ---------------------------------------------------------------------------
 
 
+# Block-level markdown that Feishu's post `md` renderer ignores (showing the
+# raw markers instead of formatting). Promoted to renderable equivalents by
+# _promote_block_markdown below. ATX headings require a space after the #'s, so
+# mid-line tokens like "issue #5" are never matched.
+_MARKDOWN_ATX_HEADING_RE = re.compile(r"^\s{0,3}#{1,6}\s+(.*?)\s*#*\s*$")
+_MARKDOWN_BLOCKQUOTE_RE = re.compile(r"^(\s*)>\s?(.*)$")
+
+# Feishu's post ``md`` renderer enforces CommonMark emphasis flanking rules: a
+# ``**`` run cannot open when the character just inside is punctuation while
+# the character just outside is a letter or digit, and cannot close in the
+# mirrored case. Chinese prose hits this constantly (``到**“协议”**的`` — CJK
+# typography puts no spaces around quotes), leaving the raw asterisks visible.
+# Such spans are rewritten by moving the offending edge punctuation outside
+# the markers (``到“**协议**”的``), which satisfies the flanking rules and is
+# visually equivalent.
+_STRONG_SPAN_RE = re.compile(r"\*\*([^*\n]+?)\*\*")
+_INLINE_CODE_SPAN_RE = re.compile(r"(`[^`\n]*`)")
+
+
+def _is_md_punctuation(char: str) -> bool:
+    # CommonMark "Unicode punctuation": general categories P* and S*.
+    return unicodedata.category(char)[0] in ("P", "S")
+
+
+def _strong_edge_ok(inner_char: str, outer_char: str) -> bool:
+    if not _is_md_punctuation(inner_char):
+        return True
+    # Punctuation just inside needs whitespace or punctuation just outside;
+    # start/end of line ("") counts as whitespace.
+    return not outer_char or outer_char.isspace() or _is_md_punctuation(outer_char)
+
+
+def _fix_strong_flanking(text: str) -> str:
+    def _rewrite(match: "re.Match[str]") -> str:
+        inner = match.group(1)
+        before = text[match.start() - 1] if match.start() > 0 else ""
+        after = text[match.end()] if match.end() < len(text) else ""
+        open_ok = _strong_edge_ok(inner[0], before)
+        close_ok = _strong_edge_ok(inner[-1], after)
+        if open_ok and close_ok:
+            return match.group(0)
+        lead, core, trail = "", inner, ""
+        if not open_ok:
+            while core and _is_md_punctuation(core[0]):
+                lead, core = lead + core[0], core[1:]
+        if not close_ok:
+            while core and _is_md_punctuation(core[-1]):
+                trail, core = core[-1] + trail, core[:-1]
+        if not core.strip():
+            # Nothing bold-able left — drop the markers instead of emitting
+            # a span that still cannot render.
+            return f"{lead}{core}{trail}"
+        return f"{lead}**{core}**{trail}"
+
+    return _STRONG_SPAN_RE.sub(_rewrite, text)
+
+
+def _fix_strong_flanking_in_line(line: str) -> str:
+    if "**" not in line:
+        return line
+    parts = _INLINE_CODE_SPAN_RE.split(line)
+    return "".join(
+        part if part.startswith("`") else _fix_strong_flanking(part)
+        for part in parts
+    )
+
+
+def _promote_block_markdown(content: str) -> str:
+    """Rewrite markdown that Feishu post/md drops, outside code.
+
+    Feishu's post ``md`` element renders inline marks (bold, italics, lists,
+    links, inline code) but ignores ATX headings (``#``) and blockquotes
+    (``>``), leaving the raw markers visible. Promote headings to bold and
+    blockquotes to a ``▎`` prefix so they render, while leaving fenced code
+    blocks verbatim (so ``#``/``>`` inside code survive). Inline ``**`` spans
+    that violate CommonMark flanking rules are rewritten so they render (see
+    _fix_strong_flanking). Tables are left untouched — current Feishu clients
+    render GFM tables in post/md natively (#52786, verified 2026-07-25).
+    """
+    if not content or (
+        "#" not in content and ">" not in content and "**" not in content
+    ):
+        return content
+
+    out: List[str] = []
+    changed = False
+    in_code_block = False
+    for raw_line in content.splitlines():
+        stripped = raw_line.strip()
+        is_fence = bool(
+            _MARKDOWN_FENCE_CLOSE_RE.match(stripped)
+            if in_code_block
+            else _MARKDOWN_FENCE_OPEN_RE.match(stripped)
+        )
+        if is_fence:
+            in_code_block = not in_code_block
+            out.append(raw_line)
+            continue
+        if in_code_block:
+            out.append(raw_line)
+            continue
+        heading = _MARKDOWN_ATX_HEADING_RE.match(raw_line)
+        if heading:
+            title = heading.group(1).strip()
+            out.append(_fix_strong_flanking_in_line(f"**{title}**") if title else "")
+            changed = True
+            continue
+        quote = _MARKDOWN_BLOCKQUOTE_RE.match(raw_line)
+        if quote:
+            # Feishu's post/md parser needs a token boundary after the visual
+            # quote bar. Without the space, an all-bold quote becomes
+            # ``▎**text**`` and the client displays the asterisks literally.
+            out.append(_fix_strong_flanking_in_line(f"{quote.group(1)}▎ {quote.group(2)}"))
+            changed = True
+            continue
+        fixed = _fix_strong_flanking_in_line(raw_line)
+        if fixed != raw_line:
+            changed = True
+        out.append(fixed)
+    if not changed:
+        return content
+    return "\n".join(out)
+
