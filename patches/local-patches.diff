+def _known_provider_model_supports_vision(provider: str, model: str) -> Optional[bool]:
+    """Return hardcoded capability for provider/model pairs missing catalog data.
+
+    Keep this narrow: these are models/providers whose public wire path accepts
+    image input but whose dynamic catalog may be unavailable or incomplete.
+    """
+    p = (provider or "").strip().lower()
+    m = (model or "").strip().lower()
+    if not p or not m:
+        return None
+
+    # Vertex's OpenAI-compatible Gemini 3.x route accepts image content, but
+    # live model discovery is unavailable and models.dev may not know newly
+    # released preview slugs yet. Without this, auto routing falls back to
+    # vision_analyze text pre-analysis, which then fails on installs with only
+    # Vertex credentials and no OpenRouter/Nous auxiliary vision backend.
+    if p in {"vertex", "google-vertex", "vertex-ai", "vertexai"}:
+        if "gemini-3" in m or "gemini-pro-3" in m or "gemini-flash-3" in m:
+            return True
+
+    # Bedrock inference-profile ARNs do not map cleanly into models.dev: the
+    # model ID is embedded after the final slash (for example
+    # ``.../global.anthropic.claude-opus-5``), so capability lookup returns
+    # unknown and auto mode falls back to lossy text pre-analysis. Claude 3+
+    # Haiku/Sonnet/Opus models accept image input through Bedrock Converse and
+    # Messages. Keep the match family- and generation-scoped: older Claude v2
+    # and opaque application-profile names remain unknown/fail-closed.
+    if p in {"bedrock", "aws-bedrock", "amazon-bedrock"}:
+        version_first = re.search(
+            r"anthropic\.claude-(\d+)(?:[-.]\d+)*-(?:haiku|sonnet|opus)(?:[-.:/]|$)",
+            m,
+        )
+        family_first = re.search(
+            r"anthropic\.claude-(?:haiku|sonnet|opus)-(\d+)(?:[-.]\d+)*(?:[-.:/]|$)",
+            m,
+        )
+        match = version_first or family_first
+        if match and int(match.group(1)) >= 3:
+            return True
+
+    return None
+
