+@pytest.mark.asyncio
+async def test_prepare_runs_video_sidecar_when_main_model_lacks_video(monkeypatch, tmp_path):
+    """PATCH-MULTIMODAL-SIDECAR: a capable fallback link describes the video
+    in-text when the main model cannot read video.
+
+    This is the production wiring test: it drives the real
+    ``_prepare_inbound_message_text`` so a broken hookup (wrong call order,
+    swallowed exception, un-consumed path list) fails here rather than only in
+    the unit test for the picker.
+    """
+    from types import SimpleNamespace
+
+    runner = _make_runner()
+    source = _source()
+    session_key = "video-sidecar-session"
+    runner._pending_native_video_paths_by_session = {}
+
+    video = tmp_path / "clip.mp4"
+    video.write_bytes(b"\x00\x00\x00\x18ftypisom\x00\x00\x02\x00isomiso2" + b"\x00" * 64)
+
+    event = MessageEvent(
+        text="what happens here?",
+        message_type=MessageType.VIDEO,
+        source=source,
+        media_urls=[str(video)],
+        media_types=["video/mp4"],
+    )
+    event.reply_to_message_id = "m-1"
+    event.reply_to_text = "check this clip"
+
+    # Main model cannot read video; the fallback link can.
+    cfg = {
+        "model": {"provider": "azure-foundry", "default": "gpt-5.5", "context_length": 128000},
+        "fallback_providers": [
+            {"provider": "vertex", "model": "google/gemini-3.5-flash"}
+        ],
+    }
+    monkeypatch.setattr("gateway.run._load_gateway_config", lambda: cfg)
+    monkeypatch.setattr(
+        runner,
+        "_resolve_session_agent_runtime",
+        lambda **_kwargs: ("gpt-5.5", {"provider": "azure-foundry", "api_key": ""}),
+    )
+    monkeypatch.setattr(
+        "hermes_cli.route_identity.should_clear_context_pin", lambda *_: False
+    )
+
+    captured = {}
+
+    async def fake_call_llm(**kwargs):
+        captured.update(kwargs)
+        return SimpleNamespace(
+            choices=[SimpleNamespace(message=SimpleNamespace(content="A cat walks by."))]
+        )
+
+    monkeypatch.setattr("agent.auxiliary_client.async_call_llm", fake_call_llm)
+
+    result = await runner._prepare_inbound_message_text(
+        event=event, source=source, history=[], session_key=session_key
+    )
+
+    # The sidecar's description replaces the path-note flow entirely.
+    assert "A cat walks by." in result
+    assert "read by a configured video-capable route" in result
+    assert "google/gemini-3.5-flash" not in result
+    assert str(video) not in result
+    assert "Its content is not inlined here" not in result
+    # It ran on the video-capable link, not the main provider.
+    assert captured["provider"] == "vertex"
+    assert captured["model"] == "google/gemini-3.5-flash"
+    assert captured["allow_provider_fallback"] is False
+    # Wire shape: Vertex rejects a ``video_url`` part with HTTP 400, so the
+    # video must ride an ``image_url`` part carrying a data:video/... URL.
+    parts = captured["messages"][0]["content"]
+    assert [p["type"] for p in parts] == ["text", "image_url"]
+    assert parts[1]["image_url"]["url"].startswith("data:video/mp4;base64,")
+    # Only the caption + quoted context travels with it — never the transcript.
+    assert "check this clip" in parts[0]["text"]
+    assert "what happens here?" in parts[0]["text"]
+    # Nothing was left buffered for a native attachment.
+    assert not runner._pending_native_video_paths_by_session.get(session_key)
