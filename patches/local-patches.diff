+            "gateway.session._lookup_person",
+            side_effect=lambda *cands: next(
+                (profiles[c] for c in cands if c in profiles), None
+            ),
+        ):
+            label = adapter._history_sender_label(
+                SimpleNamespace(id="ou_zhou", sender_type="user")
