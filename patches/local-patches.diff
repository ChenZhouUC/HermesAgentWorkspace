+    def _attachment_file_budget(self, max_files: Optional[int] = None) -> int:
+        if max_files is None:
+            max_files = getattr(
+                self,
+                "_attachment_backfill_max_files",
+                _FEISHU_BACKFILL_MAX_TOTAL_FILES,
+            )
+        try:
+            return max(0, int(max_files))
+        except (TypeError, ValueError):
+            return _FEISHU_BACKFILL_MAX_TOTAL_FILES
