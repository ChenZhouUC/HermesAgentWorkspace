+            picked,
+            key=lambda m: self._coerce_feishu_epoch_seconds(getattr(m, "create_time", None)) or 0,
+        ):
+            if len(media_urls) >= int(
+                getattr(
+                    self,
+                    "_attachment_backfill_max_files",
+                    _FEISHU_BACKFILL_MAX_TOTAL_FILES,
+                )
+            ):
