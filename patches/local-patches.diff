+    ``_GEMINI_SUPPORTED_VIDEO_MIMES``. The caller reports those paths in
+    ``skipped`` and the rest of the turn proceeds with a path-free failure status.
+    """
+    try:
+        from agent.file_safety import raise_if_read_blocked
