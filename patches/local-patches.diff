+    async def _backfill_reply_attachments(
+        self,
+        reply_to_message_id: str,
+        *,
+        max_files: Optional[int] = None,
+        deadline: Optional[float] = None,
+        budget: Optional[_AttachmentDownloadBudget] = None,
+    ) -> Optional[tuple[List[str], List[str]]]:
+        """Return (media_urls, media_types) for a quoted/replied-to image/file
+        message, or None.
+
+        ``_fetch_message_text`` downloads then discards these resources (keeping
+        only text), so we fetch them directly here. An explicit quote is never
+        suppressed by the sender-window dedupe cache: users may legitimately
+        re-quote the same image/video for a different question.
+        """
+        if not reply_to_message_id or not self._client:
+            return None
+        timeout = self._attachment_backfill_remaining_timeout(deadline)
+        return await asyncio.wait_for(
+            self._collect_reply_attachments(
+                str(reply_to_message_id),
+                max_files=max_files,
+                deadline=deadline,
+                budget=budget,
+            ),
+            timeout=timeout,
+        )
+
+    async def _collect_reply_attachments(
+        self,
+        reply_to_message_id: str,
