+    def _history_sender_label(self, sender: Any) -> str:
+        sender_type = str(getattr(sender, "sender_type", "") or "").strip().lower()
+        sender_id = str(getattr(sender, "id", "") or "").strip()
+        if sender_id and sender_id == self._app_id:
