+def _mp4_bytes() -> bytes:
+    """Return minimal ISO-BMFF bytes: an 'ftyp' box with an mp4 major brand."""
+    return b"\x00\x00\x00\x18ftypisom\x00\x00\x02\x00isomiso2" + b"\x00" * 16
