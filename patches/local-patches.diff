+"""MCP Tasks extension helpers shared by tool execution and the agent loop.
+
+The MCP Tasks extension returns a durable task handle instead of an ordinary
+``CallToolResult``.  That handle is a control-plane result: feeding it back to
+the model for a second wording pass adds latency and can wedge an otherwise
+successful asynchronous submission.  These helpers recognize only standard
+MCP task result shapes from MCP-prefixed tools and render bounded,
+deterministic Markdown tables that messaging adapters can post-process.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from typing import Any
+from urllib.parse import urlsplit
+
+
+MCP_TOOL_PREFIX = "mcp__"
+MCP_TASK_METADATA_KEY = "_mcp_task_result"
+_URL_RE = re.compile(r"https?://[^\s<>\"']+")
+_SUCCESS_STATUSES = frozenset({"completed", "complete", "succeeded", "success", "done"})
+_FAILURE_STATUSES = frozenset({"failed", "failure", "error"})
+_CANCELLED_STATUSES = frozenset({"cancelled", "canceled"})
+
+
+class _VerifiedMCPTaskResult(str):
+    """Opaque in-process proof that a negotiated Tasks call produced a value."""
+
+    def __new__(cls, value: str, tool_name: str):
+        instance = super().__new__(cls, value)
+        instance.tool_name = tool_name
+        instance.consumed = False
+        return instance
+
+
+def _payload(result: Any) -> dict[str, Any] | None:
+    if isinstance(result, dict):
+        return result
+    if not isinstance(result, str):
+        return None
+    try:
+        parsed = json.loads(result)
+    except (TypeError, ValueError):
+        return None
+    return parsed if isinstance(parsed, dict) else None
+
+
+def task_result_metadata(tool_name: str, result: Any) -> dict[str, Any] | None:
+    """Return a validated task result plus protocol provenance."""
+    if not str(tool_name or "").startswith(MCP_TOOL_PREFIX):
+        return None
+    payload = _payload(result)
+    if not payload:
+        return None
+    result_type = str(payload.get("resultType") or "")
+    task_id = str(payload.get("taskId") or "").strip()
+    status = str(payload.get("status") or "").strip()
+    if not task_id or not status:
+        return None
+    if result_type == "task":
+        kind = "created"
+    elif result_type == "complete" and str(tool_name).endswith("__tasks_get"):
+        kind = "status"
+    else:
+        return None
+    server_parts = str(tool_name).split("__", 2)
+    server = server_parts[1] if len(server_parts) == 3 else ""
+    return {"kind": kind, "server": server, "task": payload}
+
+
+def record_task_result_provenance(tool_name: str, result: Any) -> Any:
+    """Wrap one result produced by a negotiated Tasks-aware MCP call.
+
+    The marker travels with the return value across worker-thread boundaries;
+    process-global or ContextVar side channels cannot do that reliably.
+    """
+    if not isinstance(result, str) or task_result_metadata(tool_name, result) is None:
+        return result
+    return _VerifiedMCPTaskResult(result, str(tool_name or ""))
+
+
+def _consume_task_result_provenance(tool_name: str, result: Any) -> bool:
+    if not isinstance(result, _VerifiedMCPTaskResult):
+        return False
+    if result.consumed or result.tool_name != str(tool_name or ""):
+        return False
+    result.consumed = True
+    return True
+
+
+def attach_task_result_metadata(
+    tool_message: dict[str, Any], tool_name: str, result: Any
+) -> None:
+    if not _consume_task_result_provenance(tool_name, result):
+        return
+    metadata = task_result_metadata(tool_name, result)
+    if metadata is not None:
+        tool_message[MCP_TASK_METADATA_KEY] = metadata
+
+
+def _clean_text(value: Any, *, limit: int = 500) -> str:
+    text = " ".join(str(value or "").split()).strip()
+    return text[:limit]
+
+
+def _table_cell(value: Any, *, limit: int = 500) -> str:
+    return _clean_text(value, limit=limit).replace("\\", "\\\\").replace("|", "\\|")
+
+
+def _code_value(value: Any, *, limit: int = 200) -> str:
+    return _table_cell(value, limit=limit).replace("`", "'")
+
+
+def _result_links(payload: Any) -> list[str]:
+    found: dict[str, None] = {}
+
+    def visit(value: Any) -> None:
+        if isinstance(value, dict):
+            for child_value in value.values():
+                visit(child_value)
+            return
+        if isinstance(value, list):
+            for child in value:
+                visit(child)
+            return
+        if not isinstance(value, str):
+            return
+        for match in _URL_RE.findall(value):
+            url = match.rstrip(".,;:!?)]}")
+            parsed = urlsplit(url)
+            if parsed.scheme not in {"http", "https"} or not parsed.netloc:
+                continue
+            found.setdefault(url, None)
+
+    visit(payload)
+    return list(found)[:8]
+
+
+def _error_text(task: dict[str, Any]) -> str:
+    candidates = [task.get("error"), task.get("statusMessage")]
+    for candidate in candidates:
+        if isinstance(candidate, dict):
+            candidate = (
+                candidate.get("message")
+                or candidate.get("detail")
+                or candidate.get("code")
+            )
+        text = _clean_text(candidate, limit=600)
+        if text:
+            return text
+    return "No error details returned."
+
+
+def _normalized_task_status(task: dict[str, Any]) -> str:
+    status = str(task.get("status") or "").strip().lower()
+    if status in _SUCCESS_STATUSES:
+        return "completed"
+    if status in _CANCELLED_STATUSES:
+        return "cancelled"
+    if status in _FAILURE_STATUSES or task.get("error") is not None:
+        return "failed"
+    return status
+
+
+def _result_link_rows(payload: Any) -> list[tuple[str, str]]:
+    priorities = {"HTML": 0, "PDF": 1, "Preview": 2, "Download": 3, "Result URL": 4}
+    labelled = []
+    for index, url in enumerate(_result_links(payload)):
+        path = urlsplit(url).path.lower().rstrip("/")
+        leaf = path.rsplit("/", 1)[-1]
+        if leaf.endswith((".html", ".htm")):
+            label = "HTML"
+        elif leaf.endswith(".pdf"):
+            label = "PDF"
+        elif "preview" in leaf:
+            label = "Preview"
+        elif "download" in leaf:
+            label = "Download"
+        else:
+            label = "Result URL"
+        labelled.append((priorities[label], index, label, url))
+
+    labelled.sort(key=lambda item: (item[0], item[1]))
+    totals: dict[str, int] = {}
+    for _, _, label, _ in labelled:
+        totals[label] = totals.get(label, 0) + 1
+    seen: dict[str, int] = {}
+    rows: list[tuple[str, str]] = []
+    for _, _, label, url in labelled:
+        seen[label] = seen.get(label, 0) + 1
+        display_label = f"{label} {seen[label]}" if totals[label] > 1 else label
+        rows.append((display_label, url))
+    return rows
+
+
+def _render_task_table(metadata: dict[str, Any]) -> str:
+    task = metadata["task"]
+    task_id = _code_value(task["taskId"], limit=200)
+    status = _normalized_task_status(task)
+    raw_result = task.get("result")
+    rows = [("Task ID", f"`{task_id}`"), ("Status", f"`{_code_value(status)}`")]
+
+    if status == "failed":
+        rows.append(("Error", _table_cell(_error_text(task), limit=600)))
+    else:
+        detail = _clean_text(task.get("statusMessage"), limit=600)
+        redundant = detail.casefold() in {
+            "completed",
+            "complete",
+            "cancelled",
+            "canceled",
+            "working",
+            "queued",
+            "running",
+        }
+        if detail and not redundant:
+            label = "Phase" if status not in {"completed", "cancelled"} else "Detail"
+            rows.append((label, _table_cell(detail, limit=600)))
+
+    if status == "completed":
+        rows.extend(
+            (label, _table_cell(url, limit=2000))
+            for label, url in _result_link_rows(raw_result)
+        )
+
+    lines = ["| Field | Value |", "| --- | --- |"]
+    lines.extend(f"| {label} | {value} |" for label, value in rows)
+    return "\n".join(lines)
+
+
+def direct_task_response(messages: list[dict[str, Any]]) -> tuple[str, str] | None:
+    """Render trailing MCP task result(s) and return ``(text, exit_reason)``."""
+    metadata_items: list[dict[str, Any]] = []
+    for message in reversed(messages):
+        if not isinstance(message, dict) or message.get("role") != "tool":
+            break
+        metadata = message.get(MCP_TASK_METADATA_KEY)
+        if not isinstance(metadata, dict):
+            return None
+        task = metadata.get("task")
+        if (
+            metadata.get("kind") == "status"
+            and isinstance(task, dict)
+            and str(task.get("status") or "").strip().lower() == "input_required"
+        ):
+            # Input requests are standard MCP MRTR payloads that need the normal
+            # model/client handling path so the user can answer and tasks/update
+            # can carry the response. A deterministic receipt would strand the task.
+            return None
+        metadata_items.append(metadata)
+    if not metadata_items:
+        return None
+    metadata_items.reverse()
+    sections = [_render_task_table(item) for item in metadata_items]
+    reason = (
+        "mcp_task_created"
+        if any(item.get("kind") == "created" for item in metadata_items)
+        else "mcp_task_status"
+    )
+    return "\n\n".join(sections), reason
