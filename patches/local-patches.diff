+            body = getattr(item, "body", None)
+            normalized = normalize_feishu_message(
+                message_type=str(getattr(item, "msg_type", "") or ""),
+                raw_content=str(getattr(body, "content", "") or ""),
+                mentions=getattr(item, "mentions", None),
+                bot=self._bot_identity(),
