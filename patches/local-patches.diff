+                "_attachment_backfill_timeout_seconds",
+                _FEISHU_BACKFILL_TIMEOUT_SECONDS,
+            )
+        )
+        if deadline is not None:
+            timeout = min(timeout, max(0.0, deadline - asyncio.get_running_loop().time()))
