diff --git a/agent/mcp_task_protocol.py b/agent/mcp_task_protocol.py
new file mode 100644
index 0000000000000000000000000000000000000000..a9b7e547bd4743c91b10df20ed0656267067ab95
--- /dev/null
+++ b/agent/mcp_task_protocol.py
@@ -0,0 +1,108 @@
+"""MCP Tasks extension helpers shared by tool execution and the agent loop.
+
+The MCP Tasks extension returns a durable task handle instead of an ordinary
+``CallToolResult``.  That handle is a control-plane result: feeding it back to
+the model for a second wording pass adds latency and can wedge an otherwise
+successful asynchronous submission.  These helpers recognize only standard
+MCP task result shapes from MCP-prefixed tools and render bounded,
+deterministic user receipts.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+
+MCP_TOOL_PREFIX = "mcp__"
+MCP_TASK_METADATA_KEY = "_mcp_task_result"
+
+
+def _payload(result: Any) -> dict[str, Any] | None:
+    if isinstance(result, dict):
+        return result
+    if not isinstance(result, str):
+        return None
+    try:
+        parsed = json.loads(result)
+    except (TypeError, ValueError):
+        return None
+    return parsed if isinstance(parsed, dict) else None
+
+
+def task_result_metadata(tool_name: str, result: Any) -> dict[str, Any] | None:
+    """Return a validated task result plus protocol provenance."""
+    if not str(tool_name or "").startswith(MCP_TOOL_PREFIX):
+        return None
+    payload = _payload(result)
+    if not payload:
+        return None
+    result_type = str(payload.get("resultType") or "")
+    task_id = str(payload.get("taskId") or "").strip()
+    status = str(payload.get("status") or "").strip()
+    if not task_id or not status:
+        return None
+    if result_type == "task":
+        kind = "created"
+    elif result_type == "complete" and str(tool_name).endswith("__tasks_get"):
+        kind = "status"
+    else:
+        return None
+    server_parts = str(tool_name).split("__", 2)
+    server = server_parts[1] if len(server_parts) == 3 else ""
+    return {"kind": kind, "server": server, "task": payload}
+
+
+def attach_task_result_metadata(
+    tool_message: dict[str, Any], tool_name: str, result: Any
+) -> None:
+    metadata = task_result_metadata(tool_name, result)
+    if metadata is not None:
+        tool_message[MCP_TASK_METADATA_KEY] = metadata
+
+
+def _task_lines(metadata: dict[str, Any]) -> list[str]:
+    task = metadata["task"]
+    kind = metadata["kind"]
+    lines = ["MCP 异步任务已受理。" if kind == "created" else "MCP 任务状态已更新。"]
+    server = str(metadata.get("server") or "").strip()
+    if server:
+        lines.append(f"- server: `{server}`")
+    lines.append(f"- task_id: `{task['taskId']}`")
+    lines.append(f"- status: `{task['status']}`")
+    status_message = str(task.get("statusMessage") or "").strip()
+    if status_message:
+        lines.append(f"- detail: {status_message[:500]}")
+    poll_interval = task.get("pollIntervalMs")
+    if isinstance(poll_interval, int) and poll_interval > 0:
+        lines.append(f"- suggested_poll: {poll_interval / 1000:g}s")
+    if kind == "created":
+        lines.append("后续可在新消息中使用 task_id 查询状态。")
+    elif task.get("result") is not None:
+        rendered = json.dumps(task["result"], ensure_ascii=False, indent=2)
+        lines.extend(("", "结果：", f"```json\n{rendered[:4000]}\n```"))
+    elif task.get("error") is not None:
+        rendered = json.dumps(task["error"], ensure_ascii=False, indent=2)
+        lines.extend(("", "错误：", f"```json\n{rendered[:2000]}\n```"))
+    return lines
+
+
+def direct_task_response(messages: list[dict[str, Any]]) -> tuple[str, str] | None:
+    """Render trailing MCP task result(s) and return ``(text, exit_reason)``."""
+    metadata_items: list[dict[str, Any]] = []
+    for message in reversed(messages):
+        if not isinstance(message, dict) or message.get("role") != "tool":
+            break
+        metadata = message.get(MCP_TASK_METADATA_KEY)
+        if isinstance(metadata, dict):
+            metadata_items.append(metadata)
+    if not metadata_items:
+        return None
+    metadata_items.reverse()
+    sections = ["\n".join(_task_lines(item)) for item in metadata_items]
+    reason = (
+        "mcp_task_created"
+        if any(item.get("kind") == "created" for item in metadata_items)
+        else "mcp_task_status"
+    )
+    return "\n\n".join(sections), reason
