+    def _fast_run(args, *unused_args, **kwargs):
+        text_mode = bool(
+            kwargs.get("text")
+            or kwargs.get("universal_newlines")
+            or kwargs.get("encoding")
+        )
+        empty = "" if text_mode else b""
+        argv = list(args) if isinstance(args, (list, tuple)) else [str(args)]
+        # The default fixture represents an unauthenticated developer host;
+        # the dedicated gh-auth test overrides subprocess.run with success.
+        returncode = 1 if argv and os.path.basename(str(argv[0])) == "gh" else 0
+        return subprocess.CompletedProcess(
+            args,
+            returncode,
+            stdout=empty,
+            stderr=empty,
+        )
+
+    class _FastResponse:
+        status_code = 200
+        text = ""
+
+        @staticmethod
+        def json():
+            return {}
+
+    monkeypatch.setattr(subprocess, "run", _fast_run)
