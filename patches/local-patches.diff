+
+def _strong_edge_ok(inner_char: str, outer_char: str) -> bool:
+    if not _is_md_punctuation(inner_char):
+        return True
+    # Punctuation just inside needs whitespace or punctuation just outside;
+    # start/end of line ("") counts as whitespace.
+    return not outer_char or outer_char.isspace() or _is_md_punctuation(outer_char)
+
+
+def _fix_strong_flanking(text: str) -> str:
+    def _rewrite(match: "re.Match[str]") -> str:
+        inner = match.group(1)
+        before = text[match.start() - 1] if match.start() > 0 else ""
+        after = text[match.end()] if match.end() < len(text) else ""
+        open_ok = _strong_edge_ok(inner[0], before)
+        close_ok = _strong_edge_ok(inner[-1], after)
+        if open_ok and close_ok:
+            return match.group(0)
+        lead, core, trail = "", inner, ""
+        if not open_ok:
+            while core and _is_md_punctuation(core[0]):
+                lead, core = lead + core[0], core[1:]
+        if not close_ok:
+            while core and _is_md_punctuation(core[-1]):
+                trail, core = core[-1] + trail, core[:-1]
+        if not core.strip():
+            # Nothing bold-able left — drop the markers instead of emitting
+            # a span that still cannot render.
+            return f"{lead}{core}{trail}"
+        return f"{lead}**{core}**{trail}"
