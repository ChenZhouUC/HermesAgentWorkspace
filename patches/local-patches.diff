+        "status": "working",
+        "createdAt": "2026-08-19T00:00:00Z",
+        "lastUpdatedAt": "2026-08-19T00:00:00Z",
+        "message": "Preparing assets",
+    })
+
+    kind, result = asyncio.run(call_tool(session, "start", {"x": 1}))
+
+    assert kind == "task"
+    assert result["taskId"] == "42"
+    method, params, opts = dispatcher.calls[0]
+    assert method == "tools/call"
+    assert params["name"] == "start"
+    assert params["_meta"]["io.modelcontextprotocol/clientCapabilities"]["extensions"] == {
+        TASKS_EXTENSION_ID: {}
