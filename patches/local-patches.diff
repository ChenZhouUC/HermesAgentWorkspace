+    def _schedule_missed_event_backfill(self, reason: str) -> None:
+        """Schedule a bounded history replay for messages missed during outages."""
+        if not getattr(self, "_missed_event_backfill", True):
+            return
+        if getattr(self, "_client", None) is None:
+            return
+        loop = getattr(self, "_loop", None)
+        if not self._loop_accepts_callbacks(loop):
+            return
+        if not hasattr(loop, "create_task"):
+            return
+        task = getattr(self, "_missed_event_backfill_task", None)
+        if task and not task.done():
+            return
+        now = time.monotonic()
+        _last_backfill = getattr(self, "_missed_event_backfill_started_at", None)
+        if _last_backfill is not None and now - _last_backfill < _MISSED_EVENT_BACKFILL_MIN_INTERVAL_SECONDS:
+            return
+        self._missed_event_backfill_started_at = now
+        task = loop.create_task(self._run_missed_event_backfill(reason))
+        self._missed_event_backfill_task = task
+
+        def _clear_done(done: asyncio.Task) -> None:
+            if getattr(self, "_missed_event_backfill_task", None) is done:
+                self._missed_event_backfill_task = None
+            if done.cancelled():
+                return
+            self._log_background_failure(done)
+
+        task.add_done_callback(_clear_done)
