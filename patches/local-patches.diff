+def _write_stale_receipt(hermes_home, disk_sha: str) -> None:
+    receipt_dir = hermes_home / "logs" / "update_receipts"
+    receipt_dir.mkdir(parents=True)
+    (receipt_dir / "latest.json").write_text(
+        json.dumps(
+            {
+                "exit_code": 1,
+                "stop_reason": "KeyboardInterrupt: ",
+                "outcome": "failed",
+                "plan": {
+                    "expected_sha": disk_sha,
+                    "runtimes": [
+                        {
+                            "kind": "gateway",
+                            "profile": "default",
+                            "pid": 42,
+                            "code_sha": "7" * 40,
+                        }
+                    ],
+                },
+            }
+        ),
+        encoding="utf-8",
+    )
+
