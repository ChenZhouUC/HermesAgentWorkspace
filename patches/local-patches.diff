+            label = str(person.get("name") or label or "").strip() or label
+        if not label:
+            label = sender_id or sender_type or "unknown"
+        if sender_type in {"bot", "app"}:
+            return f"{label} [bot]"
+        if person:
+            qualifier = self._history_person_qualifier(person)
+            if qualifier:
