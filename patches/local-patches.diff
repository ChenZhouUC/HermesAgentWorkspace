+def decide_video_input_mode(
+    provider: str,
+    model: str,
+    cfg: Optional[Dict[str, Any]],
+) -> str:
+    """Return ``"native"`` or ``"text"`` for user-attached videos this turn.
+
+    ``native`` attaches the video bytes as a ``data:video/...`` URL on the
+    user turn (same ``image_url`` part shape the Vertex OpenAI-compat
+    endpoint expects for all inline media). ``text`` keeps the pre-existing
+    behaviour: the gateway tries a configured capable sidecar, then emits an
+    explicit path-free failure status if no route can read the attachment.
+
