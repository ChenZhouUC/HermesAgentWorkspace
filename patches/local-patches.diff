+def _derive_default_profile_addresses(name: Any) -> Dict[str, str]:
+    """Derive conservative language-specific addresses from a public profile name.
+
+    The directory convention is usually ``Given FAMILY 中文姓名(Nickname)``.  Only the
+    public ``name`` field participates: aliases and parenthetical nicknames are lookup data, not
+    permission to address someone by that value.  Ambiguous shapes stay whole instead of guessing.
+    """
+    text = " ".join(str(name or "").split()).strip()
+    if not text:
+        return {}
+    base = _PARENTHETICAL_NAME_RE.sub(" ", text)
+    derived: Dict[str, str] = {}
+
+    cjk_runs = _CJK_NAME_RUN_RE.findall(base)
+    if cjk_runs:
+        chinese_name = max(cjk_runs, key=len)
+        chinese_address = chinese_name
+        compound_surname = next(
+            (surname for surname in _COMMON_COMPOUND_CHINESE_SURNAMES if chinese_name.startswith(surname)),
+            None,
+        )
+        if compound_surname:
+            given_name = chinese_name[len(compound_surname):]
+            if len(given_name) >= 2:
+                chinese_address = given_name
+        elif len(chinese_name) == 3:
+            # A three-character Han name is the high-confidence common case:
+            # one-character surname + two-character given name.  Two-character
+            # full names keep the surname because a bare one-character given
+            # name is often unnatural or ambiguous in workplace conversation.
+            chinese_address = chinese_name[1:]
+        derived["zh"] = chinese_address
+
+    latin_tokens = _LATIN_NAME_TOKEN_RE.findall(base)
+    if latin_tokens:
+        first = latin_tokens[0]
+        if len(latin_tokens) == 1:
+            english_address = first
+        elif len(first) == 1:
+            # Initial-led and other ambiguous layouts stay whole.
+            english_address = " ".join(latin_tokens)
+        elif first.isupper():
+            # Also tolerate FAMILY Given ordering when the family name is the
+            # all-caps directory token; otherwise retain the first token used by
+            # the normal ``Given FAMILY`` organization convention.
+            english_address = next(
+                (token for token in latin_tokens[1:] if len(token) > 1 and not token.isupper()),
+                first,
+            )
+        else:
+            english_address = first
+        derived["en"] = english_address
+
+    return derived
+
