+    "video/x-flv", "video/mpegs", "video/mpg", "video/webm", "video/wmv",
+    "video/3gpp",
+})
+NATIVE_VIDEO_MAX_BYTES = 14 * 1024 * 1024
+MULTIMODAL_SIDECAR_MAX_BYTES = NATIVE_VIDEO_MAX_BYTES
+_VIDEO_MIME_BY_SUFFIX = {
+    ".mp4": "video/mp4", ".m4v": "video/mp4", ".mov": "video/mov",
+    ".mpeg": "video/mpeg", ".mpg": "video/mpg", ".webm": "video/webm",
+    ".avi": "video/avi", ".wmv": "video/wmv", ".flv": "video/x-flv",
+    ".3gp": "video/3gpp",
+}
