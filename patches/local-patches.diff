+def _sniff_audio_mime_from_bytes(raw: bytes) -> Optional[str]:
+    """Detect common audio MIME types from magic bytes."""
+    if not raw:
+        return None
+    if raw.startswith(b"RIFF") and raw[8:12] == b"WAVE":
