+def test_gateway_kind_video_routes_through_video_decision_table(monkeypatch):
+    """kind="video" must reach decide_video_input_mode (PATCH-VERTEX-VIDEO-ROUTING).
+
+    Regression: the wrapper once forwarded an unsupported ``kind=`` kwarg to
+    decide_image_input_mode; the resulting TypeError was swallowed by the
+    fail-open except and silently downgraded every gateway image AND video
