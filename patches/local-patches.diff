+            ".jsonl", ".xml", ".yaml", ".yml", ".toml", ".ini", ".cfg",
+        }:
+            mime = "text/plain"
+        else:
+            return None
+        return f"data:{mime};base64,{base64.b64encode(raw).decode('ascii')}"
+    return None
