new file mode 100644
index 0000000000000000000000000000000000000000..beea431fd8cf0c654d8ccc292c4634cae9c01650
--- /dev/null
+++ b/tools/mcp_tasks_extension.py
@@ -0,0 +1,70 @@
+"""Wire helpers for the ``io.modelcontextprotocol/tasks`` MCP extension.
+
+The installed MCP SDK does not yet expose the 2026 Tasks extension client
+methods, but its ``BaseSession.send_request`` supports arbitrary typed JSON-RPC
+requests.  Keep the small extension shim here so ``tools/mcp_tool.py`` remains
+focused on transport lifecycle and registry wiring.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from pydantic import RootModel
+
+
+TASKS_EXTENSION_ID = "io.modelcontextprotocol/tasks"
+
+
+class _RawRequest(RootModel[dict[str, Any]]):
+    pass
+
+
+class _RawResult(RootModel[dict[str, Any]]):
+    pass
+
+
+def client_capability_meta() -> dict[str, Any]:
+    return {
+        "io.modelcontextprotocol/clientCapabilities": {
+            "extensions": {TASKS_EXTENSION_ID: {}}
+        }
+    }
+
+
+def server_supports_tasks(initialize_result: Any) -> bool:
+    capabilities = getattr(initialize_result, "capabilities", None)
+    extensions = getattr(capabilities, "extensions", None)
+    return isinstance(extensions, dict) and TASKS_EXTENSION_ID in extensions
+
+
+async def call_tool(
+    session: Any, name: str, arguments: dict[str, Any] | None
+) -> tuple[str, Any]:
+    request = _RawRequest({
+        "method": "tools/call",
+        "params": {
+            "name": name,
+            "arguments": arguments or {},
+            "_meta": client_capability_meta(),
+        },
+    })
+    raw = (await session.send_request(request, _RawResult)).root
+    if raw.get("resultType") == "task":
+        return "task", raw
+
+    from mcp import types
+
+    result = types.CallToolResult.model_validate(raw)
+    if not result.isError:
+        validate = getattr(session, "_validate_tool_result", None)
+        if callable(validate):
+            await validate(name, result)
+    return "complete", result
+
+
+async def task_request(
+    session: Any, method: str, params: dict[str, Any]
+) -> dict[str, Any]:
+    request = _RawRequest({"method": method, "params": params})
+    return (await session.send_request(request, _RawResult)).root
