+        return None
+    if len(raw) > MULTIMODAL_SIDECAR_MAX_BYTES:
+        logger.warning(
+            "image_routing: %s is %.1f MB which exceeds the %d MB sidecar "
+            "inline ceiling; skipping (explicit failure fallback).",
+            path,
+            len(raw) / (1024 * 1024),
+            MULTIMODAL_SIDECAR_MAX_BYTES // (1024 * 1024),
+        )
+        return None
+    mime = _guess_audio_mime(path, raw=raw)
+    if mime not in _GEMINI_SUPPORTED_AUDIO_MIMES:
+        logger.warning(
+            "image_routing: %s is %s which the audio sidecar does not accept; "
+            "skipping (explicit failure fallback).",
+            path,
+            mime,
+        )
+        return None
+    return f"data:{mime};base64,{base64.b64encode(raw).decode('ascii')}"
+
+def build_multimodal_sidecar_data_url(path: Path, kind: str) -> Optional[str]:
+    """Build a bounded inline media URL for a one-shot sidecar request."""
+    normalized = (kind or "").strip().lower()
+    try:
+        size = path.stat().st_size
+    except OSError:
+        return None
+    if size > MULTIMODAL_SIDECAR_MAX_BYTES:
+        return None
+    if normalized == "image":
+        data_url = _file_to_data_url(path)
+        if not data_url:
+            return None
+        mime = data_url[5:].split(";", 1)[0].lower() if data_url.startswith("data:") else ""
+        if mime not in {
+            "image/png", "image/jpeg", "image/webp", "image/heic", "image/heif",
+        }:
+            return None
+        return data_url
+    if normalized == "audio":
+        return _audio_file_to_data_url(path)
+    if normalized == "video":
+        return _video_file_to_data_url(path)
+    if normalized == "document":
+        try:
+            from agent.file_safety import raise_if_read_blocked
+
+            raise_if_read_blocked(str(path))
+            raw = path.read_bytes()
+        except ValueError as exc:
+            logger.warning("image_routing: blocked local document attachment %s -- %s", path, exc)
+            return None
+        except Exception:
+            return None
+        suffix = path.suffix.lower()
+        if raw.startswith(b"%PDF-") or suffix == ".pdf":
+            mime = "application/pdf"
+        elif suffix in {
+            ".txt", ".md", ".markdown", ".csv", ".tsv", ".log", ".json",
+            ".jsonl", ".xml", ".yaml", ".yml", ".toml", ".ini", ".cfg",
+        }:
+            mime = "text/plain"
+        else:
+            return None
+        return f"data:{mime};base64,{base64.b64encode(raw).decode('ascii')}"
+    return None
