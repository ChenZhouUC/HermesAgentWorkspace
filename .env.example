# ── 大模型 / LLM ──────────────────────────────────────────

# Azure AI Foundry（当前主模型 gpt-5.5）
# AZURE_FOUNDRY_API_KEY=your_azure_foundry_api_key
# AZURE_FOUNDRY_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/v1

# AWS Bedrock（fallback[0]：Claude Opus 5 application inference profile）
# CLAUDE_AM_OPUS_ARN=arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE
# AWS_REGION=us-east-1

# Google Vertex AI（fallback[1] + compression + 视频旁路）
# OAuth token 由 Hermes 进程内 mint/refresh；路径必须是绝对路径。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# VERTEX_PROJECT_ID=your_gcp_project_id
# VERTEX_REGION=global

# ── 飞书 / Feishu ─────────────────────────────────────────

FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_DOMAIN=feishu  # feishu 或 lark，填名称不是 URL
FEISHU_CONNECTION_MODE=websocket
# FEISHU_ALLOWED_USERS=user_id_1,user_id_2   # 推荐：限制指定飞书用户
# FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxx          # 可选：Bot 启动时主动发送的频道

# ── Gateway 访问控制 ───────────────────────────────────────

# 默认关闭全局开放访问；如需开放所有平台所有用户，改为 true
GATEWAY_ALLOW_ALL_USERS=false
# 多用户场景：优先使用飞书用户 ID 白名单
# FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxx,ou_yyyyyyyyyyyy

# ── 可选：GitHub Token（Skills Hub 提速，避免限速）──────────

# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
