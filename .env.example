# ── 大模型 / LLM ──────────────────────────────────────────

# 当 config.yaml 启用 `secrets.ignore_ambient_credentials: true` 时，Hermes
# 不使用 shell / ~/.secrets 中继承的 provider 变量。请把需要的值显式填到
# 本文件生成的 ~/.hermes/.env；~/.secrets 只作为人工复制来源。

# Azure AI Foundry — 主模型：gpt-5.5
# 来源：`codex-az` 使用的 Azure OpenAI / Foundry 凭据（`AZOPENAI_*`）。
# 映射：把原 API key 与 endpoint 分别填入下面两个 `AZURE_FOUNDRY_*` key；
# endpoint 应是 OpenAI-compatible base，通常以 `/openai/v1` 结尾。
# AZURE_FOUNDRY_API_KEY=your_azure_foundry_api_key
# AZURE_FOUNDRY_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/v1

# AWS Bedrock — fallback[0]：Claude Opus 5 application inference profile
# 来源：`claude-am` 使用的 application-inference-profile ARN 与 AWS region。
# 映射：`CLAUDE_AM_OPUS_ARN` 保持同名；来源中的 `CLAUDE_AM_REGION`
# 填入 `AWS_REGION`。AWS 请求签名继续使用标准 SDK credential chain
#（SSO、shared credentials、环境变量或 instance role），不要把临时凭据写在这里。
# CLAUDE_AM_OPUS_ARN=arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE
# AWS_REGION=us-east-1

# Google Vertex AI — fallback[1] + compaction/compression + 视频旁路
# 来源：标准 Vertex service-account JSON，以及该账号所属的 GCP project/location。
# `GOOGLE_APPLICATION_CREDENTIALS` 必须填写展开后的绝对路径；建议把 JSON 放在
# `~/.hermes/credentials/` 并设为 0600。若来源路径含 `$HOME` 或 `~`，先展开再填写。
# Hermes 会在进程内 mint/refresh OAuth token；不要在 `.env` 中保存短期 access token。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# VERTEX_PROJECT_ID=your_gcp_project_id
# VERTEX_REGION=global

# ── 飞书 / Feishu ─────────────────────────────────────────

FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_DOMAIN=feishu  # feishu 或 lark，填名称不是 URL
FEISHU_CONNECTION_MODE=websocket
# FEISHU_ALLOWED_USERS=user_id_1,user_id_2   # 推荐：限制指定飞书用户
# FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxx          # 可选：Bot 启动时主动发送的频道

# ── Gateway 访问控制 ───────────────────────────────────────

# 默认关闭全局开放访问；如需开放所有平台所有用户，改为 true
GATEWAY_ALLOW_ALL_USERS=false
# 多用户场景：优先使用飞书用户 ID 白名单
# FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxx,ou_yyyyyyyyyyyy

# ── 可选：GitHub Token（Skills Hub 提速，避免限速）──────────

# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
