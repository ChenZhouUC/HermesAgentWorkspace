# ── 大模型 / LLM ──────────────────────────────────────────

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here  # 与 GEMINI_API_KEY 相同

# Google Vertex AI（service account；OAuth token 由 Hermes 进程内 mint/refresh）
# 主 vertex provider：
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# VERTEX_PROJECT_ID=your_gcp_project_id    # 留空则用凭据自带的 project
# VERTEX_REGION=global
#
# vertex-fallback（第二账号；当前用作 fallback[0] 与视频旁路，见 PATCH-VERTEX-FALLBACK）
# VERTEX_FALLBACK_CREDENTIALS_PATH=/absolute/path/to/second-service-account.json
# VERTEX_FALLBACK_PROJECT_ID=your_second_gcp_project_id

# Azure AI Foundry（当前主模型 gpt-5.5）
# AZURE_FOUNDRY_API_KEY=your_azure_foundry_api_key

# Alibaba Qwen (DashScope 国内端点)
BAILIAN_API_KEY=your_dashscope_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here  # 与 BAILIAN_API_KEY 相同
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 飞书 / Feishu ─────────────────────────────────────────

FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_DOMAIN=feishu  # feishu 或 lark，填名称不是 URL
FEISHU_CONNECTION_MODE=websocket
# FEISHU_ALLOWED_USERS=user_id_1,user_id_2   # 推荐：限制指定飞书用户
# FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxx          # 可选：Bot 启动时主动发送的频道

# ── Gateway 访问控制 ───────────────────────────────────────

# 默认关闭全局开放访问；如需开放所有平台所有用户，改为 true
GATEWAY_ALLOW_ALL_USERS=false
# 多用户场景：优先使用飞书用户 ID 白名单
# FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxx,ou_yyyyyyyyyyyy

# ── 可选：GitHub Token（Skills Hub 提速，避免限速）──────────

# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
